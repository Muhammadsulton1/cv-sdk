# redis
REDIS_HOST=localhost
REDIS_PORT=6379

S3_IDENTITY=admin
S3_HOST=localhost
S3_PORT=8333
S3_ACCESS_KEY=ACCESS_KEY
S3_SECRET_KEY=SECRET_KEY
S3_CONNECT_TIMEOUT=20
S3_READ_TIMEOUT=20


NATS_HOST=localhost
NATS_PORT=4222
STREAM_TTL=300# Задается в секундах равен 5 минутам

ROUNTING_TTL=10# секунд heartbeat для сервисов инференса живет и обновляет
TMP_PATH=../tmp
ONNX_DYNAMIC_AXIS=True